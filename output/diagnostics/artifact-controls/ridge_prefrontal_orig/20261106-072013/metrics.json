  "metric_definitions": {
    "r": "Pearson correlation per trial per axis; mean over trials, then over axes, then subjects",
    "r2": "1 - SS_res / SS_tot per trial per axis (SS_tot around the trial mean); same aggregation",
    "rmse": "root mean squared error per trial per axis (target units); same aggregation",
    "nrmse": "RMSE / (max - min of the true signal) per trial per axis; same aggregation",
    "pooled_r": "SECONDARY, labeled: Pearson r over all samples of all trials concatenated, per axis, then mean over axes; inflated by trial-to-trial stereotypy",
    "residual_r": "Pearson r per trial per axis between (prediction - T_cue) and (target - T_cue), T_cue being the cue-locked template of the training subjects; same aggregation; NaN if the prediction equals T_cue",
    "residual_r_oracle": "ANALYSIS ONLY, labeled: residual_r with the template aligned on the test trial's own kinematic onset, which a real decoder cannot know",
    "residual_r_other_trial": "CONTROL: residual_r with each trial's predicted residual paired with the target residual of another trial of the same subject, on their shared bins of time since LED-on; measures what is shared across trials",
    "residual_r_specific": "residual_r - residual_r_other_trial per subject; the part that needs the same trial"
  },
